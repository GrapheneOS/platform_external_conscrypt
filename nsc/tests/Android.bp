team {
    name: "android_network_security",
    trendy_team_id: "6092250355695616",
}

package {
    default_visibility: [
        ":__subpackages__",
    ],
    default_applicable_licenses: ["external_conscrypt_license"],
    default_team: "android_network_security",
}

android_test {
    name: "ConscryptNetworkSecurityConfigTests",
    test_suites: ["general-tests"],

    srcs: select(release_flag("RELEASE_CONSCRYPT_NSC"), {
        true: ["src/**/*.java"],
        default: [],
    }),
    certificate: "platform",
    platform_apis: true,
    sdk_version: "test_current",

    libs: [
        "android.test.base.stubs.system",
        "art.module.intra.core.api.stubs",
        "conscrypt.module.platform.api.stubs",
        "android.security.flags-aconfig-java",
        "framework-conscrypt-nsc.impl",
        "networksecurity-aconfig-flags-lib",
    ],
    static_libs: [
        "androidx.test.ext.junit",
        "androidx.test.runner",
        "flag-junit",
        "junit",
        "platform-compat-test-rules",
    ],
}
